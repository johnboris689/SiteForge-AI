# PostgreSQL Database Connection (Primary Production & Local Configuration)
# On Render, this is automatically injected from the siteforge-postgres database.
DATABASE_URL=postgresql://username:password@localhost:5432/siteforge

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="http://localhost:3000"

# GitHub OAuth & Repository Integration
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
GITHUB_CALLBACK_URL="http://localhost:3000/auth/github/callback"
GITHUB_APP_ID=""

# AI Provider Configuration (gemini | openai_compatible | custom)
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.8-flash"
OPENAI_COMPATIBLE_ENDPOINT=""
OPENAI_COMPATIBLE_API_KEY=""

# Object Storage Configuration (local | s3 | r2)
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="siteforge-artifacts"

# Authentication & Security (Used for session signing & AES-256-GCM GitHub token encryption)
SESSION_SECRET="siteforge_production_session_secret_change_me"

# Email Provider Configuration (resend | sendgrid | smtp)
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM="security@siteforge.ai"
