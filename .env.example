# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (Automatically injected by platform)
SQL_HOST="/cloudsql/instance"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_DB_NAME="postgres"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# AI Provider Configuration (gemini | openai_compatible | custom)
AI_PROVIDER="gemini"
AI_MODEL="gemini-3.8-flash"
OPENAI_COMPATIBLE_ENDPOINT=""
OPENAI_COMPATIBLE_API_KEY=""

# Object Storage Configuration (local | s3 | r2)
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="siteforge-artifacts"

# Authentication & Security
SESSION_SECRET="siteforge_production_session_secret_change_me"

# Email Provider Configuration (resend | sendgrid | smtp)
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM="security@siteforge.ai"
